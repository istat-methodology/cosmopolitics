{
	"name": "TerraDataIngestion_dynamic",
	"properties": {
		"activities": [
			{
				"name": "externalFiles",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "externalFiles",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "externalFile",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "externalFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "externaFiles",
					"value": {
						"value": "@activity('externalFiles').output.value",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"externaFiles": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}