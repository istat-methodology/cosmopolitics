{
	"name": "TerraDataIngestion_dynamic_product",
	"properties": {
		"activities": [
			{
				"name": "getExternalFiles",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"firstRowOnly": false
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "getExternalFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('getExternalFiles').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@startswith(item(),'<a')",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"externaFiles": {
				"type": "Array"
			}
		},
		"annotations": []
	}
}